# justfile (位于 yi-agent-rs/)

# 默认列出所有任务
default:
    @just --list

# === 日常开发 ===

# 格式化代码
fmt:
    cargo fmt --all

# 检查格式但不修改
fmt-check:
    cargo fmt --all -- --check

# 跑 clippy（警告当错误）
lint:
    cargo clippy --all-targets --all-features -- -D warnings

# 跑全部测试（nextest：每个测试独立进程，一个 panic 不带走同批其他测试，
# 也不会因为共享进程内的静态量互相干扰）。
#
# `--profile ci` 不能省：JUnit 只在被选中的 profile 下生成。
# nextest 不跑 doctest，但本仓库 doctest 数为 0（2026-11-01 实测 14 个 crate 全 0），
# 故无需补 `cargo test --doc`。若将来引入可执行 doctest，必须加回。
test:
    bash scripts/test-tiers.sh concurrency
    cargo nextest --version
    cargo nextest run --all-features --workspace --profile ci

# === 分级测试入口（见 docs/superpowers/plans/2026-11-07-graded-test-tiers.md） ===
#
# L0 类型检查：不产出测试二进制，因此不触发 nextest 的 --list 探测开销。
# 用 --all-targets 是必须的：默认不检查 tests/，而本仓有 108 个集成测试 target。
# 注意 L0 不承诺秒级——它比 L1 快，仅此而已。
check-fast:
    bash scripts/test-tiers.sh check

# L1 单 crate 测试。--all-features 不能省：yi-agent-store 的
# foreground-test-support feature 门控了测试辅助方法，漏掉会直接编译失败。
test-crate crate:
    bash scripts/test-tiers.sh crate {{crate}}
    cargo nextest run --all-features -p {{crate}} --profile ci

# L2 改动相关的 crate：由 git diff 推断，再交给 nextest 的 rdeps() 扩展到反向依赖。
# 默认基准是 merge-base 的两点 diff（含未提交改动）。
# 用法：just test-affected            （对比 merge-base main HEAD）
#       just test-affected origin/main （对比指定 ref）
test-affected since="":
    #!/usr/bin/env bash
    set -uo pipefail
    expr="$(bash scripts/test-tiers.sh affected {{since}})" || exit $?
    if [ -z "$expr" ]; then
        # 例如纯文档改动：affected 已说明「no tests needed」并 exit 0
        exit 0
    fi
    echo "nextest -E '$expr'"
    bash scripts/test-tiers.sh run "$expr"

# 构建（debug）
build:
    cargo build --workspace

# 构建（release）
build-release:
    cargo build --workspace --release

# === 质量度量（不进 ci，见 docs/superpowers/specs/2026-11-02-quality-hardening-wave2-design.md） ===

# 只卡「本次新增行」的覆盖率，不设全仓总阈值。
#
# 为什么不设总阈值：全仓行覆盖已 90.11%，设总阈值只会被存量拉平、失去信号。
# 为什么是手动 recipe 而非 pre-push hook：必须用独立 CARGO_TARGET_DIR 全量重编
# （占用 7.2 GB、165s 起），塞进每次 push 必被 --no-verify 绕过，等于没有。
#
# 前置条件：全量测试必须全绿。任何测试失败都会让 cargo llvm-cov 以 exit 101
# 中止且不产出 lcov 文件（实测确认 --no-fail-fast 也不行）。
#
# 必须在 git 根比对：diff-cover 用 `git diff` 的仓库相对路径（yi-agent-rs/...）
# 匹配 lcov 的绝对路径，在 yi-agent-rs/ 下运行会一条都匹配不上并输出
# "No lines with coverage information in this diff." 后 exit 0 —— 门禁静默失效。
ci-patch base="main" min="60":
    #!/usr/bin/env bash
    set -euo pipefail
    DC="$HOME/.local/share/yi-agent-tools/venv/bin/diff-cover"
    if [ ! -x "$DC" ]; then DC="$(command -v diff-cover)"; fi
    if [ ! -x "$DC" ]; then
        echo "找不到 diff-cover。安装：python3 -m venv ~/.local/share/yi-agent-tools/venv && ~/.local/share/yi-agent-tools/venv/bin/pip install diff-cover" >&2
        exit 1
    fi
    LCOV_ABS="$PWD/target/llvm-cov-target"
    mkdir -p "$LCOV_ABS"
    CARGO_TARGET_DIR="$LCOV_ABS" cargo llvm-cov --workspace --lcov \
        --output-path "$LCOV_ABS/lcov.info"
    # diff-cover 必须从 git 根运行：它拿 `git diff` 的仓库相对路径
    # （yi-agent-rs/crates/...）去比对 lcov 里的绝对路径。在 yi-agent-rs/ 下运行
    # 时一条都匹配不上，于是输出 "No lines with coverage information in this
    # diff." 并 exit 0 —— 门禁静默失效（2026-11-02 实测）。cd 到 git 根后报告才正确。
    GIT_ROOT="$(git rev-parse --show-toplevel)"
    echo "提示：$LCOV_ABS 占约 7.2 GB，回收用 rm -rf $LCOV_ABS"
    cd "$GIT_ROOT"
    "$DC" "$LCOV_ABS/lcov.info" \
        --compare-branch="{{base}}" \
        --fail-under="{{min}}"

# 变异测试：只打三处安全关键模块（工具权限 / 文件路径边界 / 外部数据解析）。
#
# 三处实测合计约 8-10 分钟（permission 2m + sse 3m + path_util 视情况），
# 刻意不进 `ci`。nightly 跑全量，本地调试可用 --in-diff。
#
# 判据不是退出码——cargo-mutants 的退出码 2（有存活体）与 3（有超时）
# 是不同问题却会互相覆盖（本次实测 permission 有 12 missed + 1 timeout，
# 只报 3）。真正的判定必须比对 mutants-baseline/*.txt。
mutants:
    #!/usr/bin/env bash
    set -uo pipefail
    # 宿主 shell 里的会话变量会污染测试（bash 的
    # bash_without_a_session_env_leaves_the_variable_unset 断言它们不存在），
    # 而 cargo-mutants 会把它当作基线失败直接 exit 4。
    unset YI_AGENT_THREAD_ID YI_AGENT_SESSION_ID
    status=0
    run_one() {
        local name="$1"; shift
        echo "=== mutants: $name ==="
        "$@" 2>&1 | tee "/tmp/mut-$name.txt" | tail -3
        local rc=${PIPESTATUS[0]}
        local now
        now="$(mktemp)"
        # 只比到 " in " 之前（即状态 + 位置 + 变异描述），去掉耗时段。
        # 耗时会随机器负载浮动，把 "67s build + 180s test" 写进基线等于
        # 每次重跑都 diff 失败。
        grep -E "^MISSED|^TIMEOUT" "/tmp/mut-$name.txt" \
            | sed -E 's/ in [0-9]+s build.*$//' > "$now" || true
        local base="mutants-baseline/$name.txt"
        if [ ! -f "$base" ]; then
            echo "缺少基线 $base，先跑一次并把 /tmp/mut-$name.txt 的 MISSED 行存进去" >&2
            status=1; rm -f "$now"; return
        fi
        if ! diff -u "$base" "$now" > /tmp/mut-diff-$name.txt; then
            echo "!! $name 的存活体与基线不一致（新增或消失），见 /tmp/mut-diff-$name.txt" >&2
            status=1
        fi
        if [ "$rc" -ne 0 ] && [ "$rc" -ne 2 ] && [ "$rc" -ne 3 ]; then
            echo "!! $name 变异测试异常退出 rc=$rc（4=基线失败，70=内部错误）" >&2
            status=1
        fi
        rm -f "$now"
    }
    # --timeout 180 而不是 60：实测 60s 会把 path_util 的 11 个守卫变异体
    # 判成 timeout，其中 2 个其实是**真存活体**（补测试后即被杀死），
    # 3 个是等价变异体。用 60s 得到的是「超时」噪音，不是可信结论。
    # permission 提到 180s 后结论与 60s 完全一致（0 missed，1 timeout），
    # 那条 timeout 是 mcp_reload 变异导致 agent 测试卡住，不是时间不够。
    run_one permission cargo mutants --file crates/yi-agent-core/src/permission.rs --timeout 180 -j 8
    run_one sse cargo mutants --file crates/yi-agent-llm/src/sse.rs --timeout 180 -j 8
    run_one path_util env "YI_FIXTURE_DIR=$PWD/../docs/research/fixtures/2026-10-07-document-samples" \
        cargo mutants --config .cargo/mutants.toml \
        --file crates/yi-agent-tools/src/fs/path_util.rs --timeout 180 -j 6
    exit $status

# Agent golden-set eval：评结果 + 评轨迹。
#
# 为什么评轨迹：只评结果的话，「工具选错但碰巧把文件写出来」测不出来。
# 轨迹断言（must_call / must_not_call / max_tool_calls / max_input_tokens）
# 才能抓到过程错误。
#
# 不进 `ci`：真实 API 调用（真钱）+ 分钟级耗时。
# 用法：
#   just eval                 跑全部，并与 tests/eval/baseline/ 比对（抓轨迹回归）
#   just eval 007             只跑 id 含 007 的
#   just eval bless=1         把本次结果写成新基线（**只在确认改动是改进时用**）
#   just eval 007 bless=1     只重写 007 的基线
#
# baseline 的三层判定见 crates/yi-agent/tests/eval/baseline.rs 的模块注释。
# 关键一点：**不比对工具调用序列**——这个 agent 写同一文件会在
# write/edit/cat>/printf>/sed -i 之间随机选择，严格比对序列会大量假红，
# 而假红会训练人无脑 bless，机制直接失效。
#
# bless 绝不能进 CI：CI 里 bless = 每次重写基线，基线永远等于最新代码，
# 检测能力归零。比对逻辑本身的单测（不需要 key）在 `eval-baseline-check`，
# 那个进 ci。
eval filter="" bless="":
    #!/usr/bin/env bash
    set -euo pipefail
    # 配置源必须是 models.json，不能 source ../.env：本仓库没有 .env
    # （.gitignore 里也没有），source 失败被 `|| true` 吞掉后
    # skip_if_no_key 直接 return —— 输出「跑了 0 条 case」且退出码 0，
    # 看起来是绿的其实一条都没跑。
    unset ANTHROPIC_API_KEY OPENAI_API_KEY MODEL_API_KEY MODEL_API_URL YI_AGENT_PROVIDER YI_AGENT_MODEL
    eval "$(bash scripts/export-model-env.sh)"
    if [ -z "${MODEL_API_KEY:-}" ]; then
        echo "SKIPPED: no headless configuration (models.json has no usable default entry)"
        exit 0
    fi
    # EVAL_BLESS 走环境变量而不是 cargo 的 `--` 后参数：cargo test 自己解析
    # `--` 之后的内容，塞自定义 flag 会报 "Unrecognized option"。
    EVAL_FILTER="{{filter}}" EVAL_BLESS="{{bless}}" cargo test -p yi-agent --test eval_baseline \
        -- --ignored --nocapture

# eval baseline 比对逻辑的自检：不需要 API key、毫秒级，故进 `ci`。
# 它钉住的是「什么算回归」这些判据本身——判错会静默放过真退化
# （例如把内容比对写坏、把容忍度调成 1000%），靠人读代码保证不了。
eval-baseline-check:
    cargo test -p yi-agent --test eval_baseline -- --skip golden_set_eval

# === CI 入口 ===

# 依赖漏洞审计。实测约 67s（含 git fetch advisory-db），不需要编译，所以进 `ci`。
#
# 为什么不只放 nightly：新披露的 CVE 针对的是**没改动过的依赖**，
# 等开发者触碰相关代码才暴露是不可接受的。nightly 里再跑一次，
# 用于捕获「依赖没变但新 CVE 被披露」（那一跑不进 lockfile 变更）。
#
# 豁免清单在 .cargo/audit.toml，每条都带复查条件。这里**不**加
# `--deny warnings`：unmaintained 类告警是不可修的，加 deny 会让门禁
# 因必然失败的条目永久变红，反而训练人忽略它。
#
# 走 scripts/audit-deps.sh 而不是裸 `cargo audit`：后者对「网络失败」和
# 「真发现漏洞」返回同一个退出码 1（实测 0.22.2，详见脚本头注释），导致
# advisory-db 一次性拉取失败就整条 CI 变红。假红会训练人忽略这道门禁。
# 包装层做的事：区分两者；网络失败时重试 → 降级到本地缓存 → 明确告警，
# 但**绝不**降级真漏洞。
audit:
    bash ../scripts/audit-deps.sh

# MSRV 门禁。`Cargo.toml` 的 `rust-version` 只是个声明，没人编译就等于谎话：
# 声明 1.85 期间真实下限已经是 1.89（lopdf 0.45 → aes 0.9.3），却一直没红。
# 工具链缺失时明确报错，不静默跳过（跳过等于门禁假绿）。
msrv-check:
    bash scripts/check-msrv.sh .

# msrv-check 自身的测试（负向断言：缺 Cargo.toml / 缺 rust-version /
# 没装工具链都必须退出非 0）。不进 `ci` 的依赖列表；单独跑用
# `just msrv-check-test`。
msrv-check-test:
    bash scripts/test_check_msrv.sh

# audit-deps.sh 自身的分支自测（假 cargo 驱动，不需网络）。
# 必须进 ci：那层包装的核心职责是「不把真漏洞降级成网络问题」，判错是静默
# 失效——平时全绿、真有漏洞也不报。只靠人读脚本保证不了。
audit-deps-check:
    bash ../scripts/test_audit_deps.sh

# nightly workflow 的静态守卫：核对它引用的 recipe / script / models.json
# 字段名与真实定义一致。nightly 不在 PR 上跑，坏了几周都可能没人发现——
# 「改了个 recipe 名，workflow 还在调旧名」这类静默失效靠静读发现不了。
nightly-workflow-check:
    bash ../scripts/test_nightly_workflow.sh

ci: fmt-check lint test build bindings-check secret-check npm-version-check ios-version-check release-env-check tag-gate-check plugin-release-check build-env-check model-setup-docs-check desktop-target-dir-check rebuild-install-check msrv-check eval-baseline-check nightly-workflow-check audit-deps-check reclaim-check affected-check audit
    @echo "CI passed"

# Magpie agent 插件检查（需 Node）。刻意不进 `ci`：GitLab MR 的 `rust:latest`
# 镜像没有 Node，塞进去会把整条流水线拖垮；由 `.github/workflows/magpie-agent-yi-agent.yml`
# 按路径单独触发。本地可用 `just magpie-agent-yi-agent-check` 跑。
magpie-agent-yi-agent-check:
    bash ../scripts/test-magpie-agent-yi-agent.sh

# 桌面端类型检查 + 单元测试。需要 Node，故**不进** `ci` 依赖列表：
# MR 路径的 `ci-mr` 用的是 `rust:latest` 镜像，没有 Node；塞进去会把整条
# 流水线拖垮。与 `magpie-agent-yi-agent-check` 同类，由独立 job 跑。
#
# 用 `tsc --noEmit` 而不是 `npm run build`：门禁要的是类型正确，产出 `dist/`
# 是发布步骤。用 `npx vitest run` 而不是 `npm test`：避免以后 test 脚本被改成
# watch 模式后门禁挂死。用 `npm ci` 而不是 `npm install`：严格按 lock 安装且不改它。
desktop-check:
    cd ../desktop && npm ci
    cd ../desktop && npx tsc --noEmit
    cd ../desktop && npx vitest run

# 共享运行时生命周期：真进程验收 + 各层集成目标。
#
# 为什么是单独 recipe 而不是塞进 `test`：这里的目标多数会真的 spawn guardian／
# daemon／子进程，且个别用例要等真实的 10 秒优雅窗口。放进 `cargo nextest run
# --workspace` 会让普通 `just test` 从十几秒变成几分钟，而日常改动大多用不到真
# 进程。CI 的 macos job 单独调用本 recipe（见 .github/workflows/ci.yml）。
#
# `runtime_process_helper` 是固定 `#[ignore]` 的 OS fixture，只由 harness 用
# `--exact --ignored` 启动；默认运行与 `--run-ignored all` 都必须排除它
# （见 .config/nextest.toml 的 default-filter）。
runtime-lifecycle-check:
    cargo test -p yi-agent --test managed_runtime_lifecycle
    cargo test -p yi-agent --test managed_roles
    cargo test -p yi-agent --test frontend_runtime_lease
    cargo test -p yi-agent-supervisors --test managed_bringup
    cargo test -p yi-agent-supervisors --test managed_process_groups
    cargo test -p yi-agent-supervisors --test managed_channel
    cargo test -p yi-agent-supervisors --test managed_channel_authority
    cargo test -p yi-agent-store --test managed_attach_authority
    cargo test -p yi-agent-supervisors --test client_reclamation
    cargo test -p yi-agent-supervisors --test execution_admission
    cargo test -p yi-agent-supervisors --test guardian_control
    cargo test -p yi-agent-supervisors --test guardian_status
    cargo test -p yi-agent-supervisors --test guardian_handover
    cargo test -p yi-agent-supervisors --test runtime_switch
    cargo test -p yi-agent-supervisors --test runtime_migration
    cargo test -p yi-agent-supervisors --test runtime_scope
    cargo test -p yi-agent-supervisors --test runtime_restart_preview
    cargo test -p yi-agent-subagent --test executor_isolation
    cargo test -p yi-agent-subagent --test executor_bridge
    cargo test -p yi-agent-subagent --test executor_gate
    cargo test -p yi-agent-subagent --test bringup_policy
    cargo test -p yi-agent-tools --test managed_bash

# 插件 workspace 的独立门禁：插件有自己的 Cargo workspace 与版本号，
# 主程序 `just ci` 不编译它（否则改一次看板就要重编整个宿主）。
#
# 刻意**不**进 `ci`：这里需要 Node（UI）与插件自己的 target 目录，塞进主
# Rust 门禁会让没有 Node 的环境（GitLab MR 的 `rust:latest`）整条挂掉。
plugin-workspace-check:
    cd ../plugins/superpowers-kanban && cargo fmt --all -- --check
    cd ../plugins/superpowers-kanban && cargo test --workspace

# 插件的 UI 门禁。与 `desktop-check` 同形：`npm ci` 严格按 lock，
# `tsc --noEmit` 查类型，`vitest run` 跑一次就退（不进 watch）。
plugin-ui-check:
    cd ../plugins/superpowers-kanban/ui && npm ci
    cd ../plugins/superpowers-kanban/ui && npx tsc --noEmit
    cd ../plugins/superpowers-kanban/ui && npx vitest run

# 公共契约（socket / driver / IPC）的唯一权威在 `plugins/contracts/`，
# 宿主与插件两侧都读它。改动任何一侧都必须先改契约并让这里通过。
plugin-contracts-check:
    node ../scripts/plugins/check-contracts.mjs
    node --test ../scripts/plugins/check-contracts.test.mjs

# 宿主边界：主程序里不得出现看板专属路径。与上面三项合起来构成
# 「插件可以独立发版」的静态证据。
plugin-boundary-check:
    python3 ../scripts/plugins/check-host-boundary.py
    python3 -m unittest discover -s ../scripts/plugins -p 'test_check_host_boundary.py'

# 验收报告校验器与执行器：A01–A20 必须各有且仅有一个最终结果，全部 pass，且
# 证据形态合规（probe 构建不能冒充正式包；A16/A17 不能用 loopback 冒充远端）。
# 执行器自身的决策/执行层也要在这里自测——它是产出证据的唯一来源，
# 它错了，上面的校验器只会忠实地校验一份错的报告。
plugin-acceptance-check:
    node --test ../scripts/plugins/e2e-report.test.mjs
    node --test ../scripts/plugins/fault-matrix.test.mjs
    node --test ../scripts/plugins/e2e.test.mjs
    node --test ../scripts/plugins/remote-facts.test.mjs
    node --test ../scripts/plugins/remote-client.test.mjs
    node --test ../scripts/plugins/e2e-remote.test.mjs

# 真跑 A01–A20 并写出验收报告（T27）。默认只跑 probe 构建：A16/A17 在没有
# 远端主机时如实记 unsupported，A20 在没有官方签名包时同样记 unsupported——
# 这两条是发布门槛，不是本地能糊过去的东西。
#   just plugin-acceptance-run                       # 写 report.json
#   just plugin-acceptance-run --suite A01 --require-pass
plugin-acceptance-run *args:
    node ../scripts/plugins/e2e.mjs --output ../.artifacts/plugins/acceptance.json {{args}}

# 真跑故障注入矩阵（T27 Step 2）。慢（要编译三个 crate），故不进 `ci`；
# 想留证据时加 `just plugin-fault-matrix`，报告写到 .artifacts/。
plugin-fault-matrix:
    node ../scripts/plugins/fault-matrix.mjs --output ../.artifacts/plugins/fault-matrix.json

# 同一 .app 上插件 v1→v2 的完整验收（T27 Step 4）：UI 变了、清单摘要与 skill
# 来源对得上、主程序字节没变、卸载后用户数据还在。需要一个已构建的 .app：
#   just plugin-update-check /Applications/yi-agent.app
plugin-update-check app:
    bash scripts/verify-plugin-update.sh "{{app}}" ..

# 一次跑完插件的全部门禁（本地用；CI 拆成独立 job 以便并行与隔离权限）。
plugin-check: plugin-workspace-check plugin-ui-check plugin-contracts-check plugin-boundary-check plugin-acceptance-check

# 校验 ts-rs 生成物与提交物一致（改了 protocol.rs 必须重新生成）。
# `export_bindings` 是 ts-rs 自动生成的测试名前缀，按前缀过滤即可覆盖全部类型。
bindings-check:
    cargo nextest run --all-features -p yi-agent-app-server export_bindings
    git diff --exit-code -- ../desktop/src/lib/generated

# 凭据卫生：挡住真实部署凭据进入跟踪文件。
# 只扫 git 跟踪文件，故 deploy/relay/.relay-local.md 这类已忽略文件不参与。
secret-check:
    bash ../scripts/check-secrets.sh

# npm 版本同步自测：发布前主包版本、子包版本、optionalDependencies 必须一起走，
# 且 platforms/ 目录与依赖表逐一对应。依赖表脱节会让用户装到旧版平台包。
npm-version-check:
    bash scripts/test_sync_npm_versions.sh

# iOS 版本号必须跟随 workspace 版本：硬编码的 0.1.0 会让手机 APP 与主线分叉，
# 而装到手机上的包自报的版本正是用户判断该不该升级的唯一依据。
ios-version-check:
    bash ../desktop/scripts/test_ios_version_sync.sh

# 发布 workflow 的环境假设（$HOME 推导 target 目录、rustup update、
# 三平台 target）：任一被破坏，tag 触发的发布会在构建第一步秒挂。
release-env-check:
    bash scripts/test_release_workflow_env.sh

# 桌面脚本不得硬编码 target 目录：CI 把 CARGO_TARGET_DIR 指到别处时，
# 写死的路径会变成「编译全绿、cp 找不到产物」这种最难查的失败。
desktop-target-dir-check:
    bash ../desktop/scripts/test_scripts_target_dir.sh

# 面向用户的配置说明不得再教人往 `.env` 写模型 key，也不得声称 App 内没有设置入口。
# 模型配置只认 `~/.yi-agent/models.json`；错误文案会把新用户挡在门外
# （照做后 `run` 直接报「尚未配置模型」并 exit 1）。
model-setup-docs-check:
    bash scripts/test_model_setup_docs.sh
    bash scripts/check-model-setup-docs.sh

# rebuild.sh 安装段自测：dev/stable 各装到哪、全局软链指向谁、拒绝覆盖真实文件。
# 该失败却静默成功时，用户会以为全局 `yi-agent` 已是新版而实际全在用旧的。
rebuild-install-check:
    bash ../scripts/test_rebuild_global_link.sh

# 发布门禁自测：tag 必须落在 main 可达的提交上。release.yml 只由 tag 触发、
# 只打包不跑测试，所以打在未合并功能分支上的 tag 会被直接发出去。
tag-gate-check:
    bash scripts/test_check_tag_on_main.sh

# 插件发布门禁自测：插件 tag 必须与主程序 tag 分开，且版本与插件 workspace/UI
# 一致。插件独立发版的前提是"一次插件改动不推动主程序版本号"，而那条规则
# 只能靠 tag 形状与两处版本号的一致性来守。
plugin-release-check:
    bash scripts/test_check_plugin_release.sh

# 构建环境门禁自测：PATH 必须让 rustup 的 Rust 优先于 Homebrew 的 Rust，
# 否则交叉编译会以 E0463 "can't find crate for core" 秒挂（实测 0.5~3 秒），
# 正是 v0.1.4~v0.1.7 每次 release 的失败形态；另外要抬高文件描述符上限。
build-env-check:
    bash scripts/test_setup_build_env.sh

# 在当前 shell 装好构建环境（重排 PATH、抬高 fd、校验三平台 std 与 zig）。
# 用法：`source <(just --evaluate ...)` 不适用，直接 source 脚本：
#   source scripts/setup-build-env.sh
build-env:
    bash scripts/setup-build-env.sh --check

# === 真实 LLM 测试(需 API key,默认跳过) ===

# 跑真实 LLM provider 层测试
# 配置源：`~/.yi-agent/models.json` 的默认条目（见 scripts/export-model-env.sh）
test-real-llm:
    #!/usr/bin/env bash
    set -e
    # 清除 shell 环境变量污染(如 ~/.zshrc 里的全局 key),让 models.json 成为唯一配置源
    unset ANTHROPIC_API_KEY OPENAI_API_KEY MODEL_API_KEY MODEL_API_URL YI_AGENT_PROVIDER YI_AGENT_MODEL
    # 从 models.json 的默认条目导出;无 key / 无 python3 时它自己会提示并 exit 0
    eval "$(bash scripts/export-model-env.sh)"
    if [ -z "$ANTHROPIC_API_KEY" ] && [ -z "$OPENAI_API_KEY" ] && [ -z "$MODEL_API_KEY" ]; then
        echo "SKIPPED: no provider API key configured (models.json has no usable default entry)"
        exit 0
    fi
    # 通用键优先:models.json 给的是 MODEL_API_KEY + provider/model 三件套,
    # 而 provider 层测试认的是各家专属变量名。出厂 provider 只按它分派。
    if [ -n "$MODEL_API_KEY" ] && [ -n "$YI_AGENT_PROVIDER" ]; then
        case "$YI_AGENT_PROVIDER" in
            anthropic) export ANTHROPIC_API_KEY="$MODEL_API_KEY" ;;
            openai) export OPENAI_API_KEY="$MODEL_API_KEY" ;;
        esac
    fi
    if [ -n "$ANTHROPIC_API_KEY" ]; then
        cargo test -p yi-agent-llm --test real_integration real_anthropic_ -- --ignored --test-threads=1
    fi
    if [ -n "$OPENAI_API_KEY" ]; then
        cargo test -p yi-agent-llm --test real_integration real_openai_ -- --ignored --test-threads=1
    fi

# 跑真实 LLM 端到端测试(经 `yi-agent run`)
# 配置源：`~/.yi-agent/models.json` 的默认条目（见 scripts/export-model-env.sh）
test-real-e2e:
    #!/usr/bin/env bash
    set -e
    unset ANTHROPIC_API_KEY OPENAI_API_KEY MODEL_API_KEY MODEL_API_URL YI_AGENT_PROVIDER YI_AGENT_MODEL
    eval "$(bash scripts/export-model-env.sh)"
    if [ -z "$MODEL_API_KEY" ]; then
        echo "SKIPPED: no headless configuration (models.json has no usable default entry)"
        exit 0
    fi
    cargo test -p yi-agent --test e2e_real -- --ignored --test-threads=1

# 跑复杂 one-shot 任务测试(Tier 3)
# 配置源：`~/.yi-agent/models.json` 的默认条目（见 scripts/export-model-env.sh）
test-real-complex:
    #!/usr/bin/env bash
    set -e
    unset ANTHROPIC_API_KEY OPENAI_API_KEY MODEL_API_KEY MODEL_API_URL YI_AGENT_PROVIDER YI_AGENT_MODEL
    eval "$(bash scripts/export-model-env.sh)"
    if [ -z "$MODEL_API_KEY" ]; then
        echo "SKIPPED: no headless configuration (models.json has no usable default entry)"
        exit 0
    fi
    cargo test -p yi-agent --test e2e_complex -- --ignored --test-threads=1

# 跑 subagent 真实 LLM 回归测试（忽略态；缺少任何 key 时成功 skip）
test-real-subagent:
    #!/usr/bin/env bash
    set -e
    unset ANTHROPIC_API_KEY OPENAI_API_KEY MODEL_API_KEY MODEL_API_URL YI_AGENT_PROVIDER YI_AGENT_MODEL
    eval "$(bash scripts/export-model-env.sh)"
    cargo test -p yi-agent --test subagent_real_e2e -- --ignored --test-threads=1

# 跑所有真实 LLM 测试(Tier 1 + 2 + 3)
test-real-all: test-real-llm test-real-e2e test-real-complex test-real-subagent
    @echo "All real LLM tests passed"

# === Release ===

# 三平台目标列表
targets := "x86_64-apple-darwin aarch64-apple-darwin x86_64-unknown-linux-gnu"

# 版本号（从 Cargo.toml workspace 读）
version := `grep '^version' Cargo.toml | head -1 | awk -F'"' '{print $2}'`

# npm 包目录
npm-dir := "yi-agent-cli"

# 平台子包目录名列表
platform-dirs := "darwin-x64 darwin-arm64 linux-x64"

# 构建产物目录（遵循 CARGO_TARGET_DIR 环境变量）
target-dir := env_var_or_default("CARGO_TARGET_DIR", "target")

# 交叉编译单个目标
build-target target:
    #!/usr/bin/env bash
    set -e
    # 先确认工具链可用：PATH 里若有 Homebrew 的 Rust 抢在 rustup 前面，
    # 这里会立即失败并说明原因，而不是让 cargo 报出难懂的 E0463。
    SETUP_BUILD_ENV_TARGETS="{{ target }}" source scripts/setup-build-env.sh
    if echo "{{ target }}" | grep -q "linux"; then
        cargo zigbuild --release --target {{ target }}
    else
        cargo build --release --target {{ target }}
    fi

# 交叉编译三平台
build-all-targets:
    #!/usr/bin/env bash
    set -e
    for target in {{ targets }}; do
        echo "Building $target..."
        just build-target "$target"
    done

# 打包单个目标为 tarball + SHA256
package-target target:
    #!/usr/bin/env bash
    set -e
    mkdir -p dist
    tar -czf "dist/yi-agent-{{ target }}.tar.gz" \
        -C "{{ target-dir }}/{{ target }}/release" yi-agent
    if command -v shasum >/dev/null; then
        shasum -a 256 "dist/yi-agent-{{ target }}.tar.gz"
    else
        sha256sum "dist/yi-agent-{{ target }}.tar.gz"
    fi | awk '{print $1}' > "dist/yi-agent-{{ target }}.tar.gz.sha256"

# 打包三平台
package-all: build-all-targets
    #!/usr/bin/env bash
    set -e
    for target in {{ targets }}; do
        just package-target "$target"
    done

# 构建 macOS 桌面 App 并放进 npm 的 darwin-arm64 子包。
# 单独成 task 而不是塞进 npm-pack：Tauri 构建要十分钟，本地只发
# CLI 时不该被迫等它；CI 在 publish 前显式调用。
npm-pack-desktop:
    #!/usr/bin/env bash
    set -e
    bash ../desktop/scripts/package-npm-app.sh

# 组装 npm 包（填充子包二进制 + 同步版本号）
npm-pack: package-all
    #!/usr/bin/env bash
    set -e
    for dir in {{ platform-dirs }}; do
        if [ "$dir" = "darwin-x64" ]; then
            target="x86_64-apple-darwin"
        elif [ "$dir" = "darwin-arm64" ]; then
            target="aarch64-apple-darwin"
        elif [ "$dir" = "linux-x64" ]; then
            target="x86_64-unknown-linux-gnu"
        else
            echo "ERROR: Unknown platform dir: $dir" >&2
            exit 1
        fi
        mkdir -p "{{ npm-dir }}/platforms/$dir/binaries"
        cp "{{ target-dir }}/$target/release/yi-agent" \
            "{{ npm-dir }}/platforms/$dir/binaries/yi-agent"
    done
    # 同步版本号到主包、所有子包，以及主包的 optionalDependencies。
    # 依赖表必须跟着版本走：只改 "version" 会让 npm 装到旧版平台包
    # （0.1.3 主包依赖仍写 0.1.0，用户装出来是占位二进制）。
    # 脚本同时自检 platforms/ 目录与依赖表是否逐一对应，脱节即失败。
    bash scripts/sync-npm-versions.sh "{{ version }}" "{{ npm-dir }}"

# 发布到 npm(CI 调用,子包先发)
# 容错:已发布的版本自动跳过(npm 不允许覆盖)
npm-publish: npm-pack
    #!/usr/bin/env bash
    set -e

    publish_if_new() {
        # $1 = package directory, $2 = package name@version
        local pkg_dir="$1"
        local pkg_ver="$2"
        if npm view "$pkg_ver" >/dev/null 2>&1; then
            echo "  → $pkg_ver already published, skipping"
        else
            (cd "$pkg_dir" && npm publish --access public)
        fi
    }

    for dir in {{ platform-dirs }}; do
        echo "Publishing @yi-agent/yi-agent-$dir@{{ version }}..."
        publish_if_new "{{ npm-dir }}/platforms/$dir" "@yi-agent/yi-agent-$dir@{{ version }}"
    done
    echo "Publishing @yi-agent/yi-agent@{{ version }}..."
    publish_if_new "{{ npm-dir }}" "@yi-agent/yi-agent@{{ version }}"

# Release 流水线入口（CI 调用）
release: clean npm-pack
    @echo "Release artifacts ready in dist/"

# 清理
clean:
    #!/usr/bin/env bash
    cargo clean
    rm -rf dist
    rm -rf "{{ npm-dir }}/platforms"/*/binaries

# 回收 target 里可证明无用的产物，不整体 `cargo clean`。
#
# `cargo clean` 会把编译缓存一起丢掉，下一次从零编（全量约十几分钟）；
# 而 target 里真正无限增长的是**孤儿 `.o`**：macOS dev/test profile 默认
# `split-debuginfo = "unpacked"`，每个 codegen unit 的 DWARF 落在
# `deps/<crate>-<hash>.<mid>.<idx>.rcgu.o`，hash 随依赖/feature 变化，
# 旧 hash 的文件 cargo 再也不碰。实测主仓库曾积到 78 万个、135 GiB。
#
# cargo 从不读取这些 `.o`（删光后 `cargo build` 1.6 秒完成且不重编），
# 所以回收它们是纯收益。新构建不再产生 `.o` 由 Cargo.toml 的
# `[profile.dev] split-debuginfo = "packed"` 保证，本 recipe 只清存量。
#
# `--include-worktrees` 会一起清 `.worktrees/*` 的 target——那些目录常常被
# 遗忘，且各自是完整的一份。
# 用法：
#   just reclaim                                 预演，只报告不删
#   just reclaim --apply                         真的删
#   just reclaim --apply --include-worktrees     连 .worktrees/* 的 target 一起
#   just reclaim --apply --prune-units 1         额外裁掉每个 crate 多余的单元目录
#
# 用变参 `*flags` 而不是具名参数：`just reclaim --apply` 会把 `--apply` 当成
# 位置参数塞给具名形参，静默变成「预演」——看着成功、其实一个文件都没删。
reclaim *flags: reclaim-check
    bash scripts/reclaim-target.sh {{ flags }}

# reclaim-target.sh 的判据自测（假文件驱动，不编译、秒级）。
# 进 `ci`：该脚本的动作是 rm，判据写宽会删掉活跃编译单元、写窄等于没清理，
# 两种错误都不报错、只能靠断言发现。
reclaim-check:
    bash scripts/test_reclaim_target.sh

# test-tiers.sh 的判据自测（假 git 输出驱动，不编译、秒级）。
# 进 ci 的理由同 reclaim-check：判据写宽会把 desktop/ 当 crate 跑，
# 写窄会静默少测——两种都不报错，只能靠断言发现。
affected-check:
    bash scripts/test_test_tiers.sh
