{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window. The app commands are listed explicitly: declaring an app ACL manifest makes every custom command denied by default, so the main window must opt in to each one it uses.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "opener:allow-open-url",
    "opener:allow-default-urls",
    "dialog:allow-open",
    "allow-kill-remote-slots",
    "allow-remote-connect",
    "allow-remote-disconnect",
    "allow-remote-enabled",
    "allow-remote-list",
    "allow-remote-remove",
    "allow-remote-status",
    "allow-remote-upsert",
    "allow-restart-sidecar",
    "allow-rpc",
    "allow-rpc-respond",
    "allow-set-relay-url",
    "allow-open-plugin-view",
    "allow-close-plugin-view",
    "allow-plugin-committed-activation",
    "allow-runtime-acquire-project",
    "allow-runtime-release-project",
    "allow-runtime-registered-projects",
    "allow-runtime-quit-outcome",
    "allow-runtime-status",
    "allow-runtime-preview",
    "allow-runtime-confirm",
    "allow-runtime-operation",
    "allow-runtime-active-operation",
    "allow-runtime-known-scopes",
    "allow-runtime-scope-for-project",
    "allow-plugin-host-identity",
    "allow-plugin-bind-host",
    "allow-foreground-root-recovery-inspect",
    "allow-foreground-root-recovery-prepare",
    "allow-foreground-root-recovery-confirm",
    "allow-foreground-root-recovery-operation",
    "allow-runtime-plugin-demand-acquire",
    "allow-runtime-plugin-demand-release",
    "allow-runtime-migration-preview",
    "allow-runtime-migration-confirm",
    "allow-runtime-migration-operation",
    "allow-runtime-active-migration"
  ]
}
