# === Model Provider ===
# 模型配置已迁到 ~/.yi-agent/models.json（由设置 UI 或 `model/*` RPC 管理）。
# 如需临时覆盖，用 CLI 参数或真实环境变量整包给出：--provider + --api-key（--api-url 可选）。

# === Agent ===
YI_AGENT_MAX_TURNS=20
YI_AGENT_MAX_DIRECT_CHILDREN=4
YI_AGENT_MAX_RESIDENT_SUBAGENTS=64
YI_AGENT_WORKDIR=.
YI_AGENT_SYSTEM_PROMPT=
YI_AGENT_COMPACT_RATIO=80
YI_AGENT_COMPACT_USER_BUDGET_TOKENS=20000
YI_AGENT_COMPACT_TOOL_BUDGET_TOKENS=12000

# === Tools ===
BOCHA_API_KEY=
