{
  "name": "superpowers-kanban-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The kanban board's own UI. Built as static assets and shipped inside the plugin, so the host app never has to be recompiled to change it.",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@yi-agent/plugin-sdk": "file:../../sdk",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^27.0.1",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^3.2.7"
  }
}
