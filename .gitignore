# Rust build artifacts
/target/
**/target/

# Rust backup files
*.rs.bk
*.rs.orig

# Cargo.lock is committed for binary crates, ignored for library crates.
# Since this is a CLI (binary), we keep Cargo.lock tracked.

# IDE / editor
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Environment / secrets
.env
.env.*
!.env.example

# Logs / runtime
*.log

# yi-agent runtime state under each project workdir
# (unix socket, instance lock, runtime.sqlite and its -wal/-shm sidecars)
.yi-agent/

# Git worktrees (isolated workspaces)
.worktrees/

# Claude Code hook state (记录上次检查到的 commit,用于增量检测代码变化)
.claude/.last-checked-commit
.claude/.last-merge-checked


# Added by cargo

/target

# npm package binaries (构建时填充,不入版本控制)
yi-agent-rs/yi-agent-cli/platforms/*/binaries/
yi-agent-rs/yi-agent-cli/platforms/*/yi-agent.app/
.worktrees/
dist/

# cargo-mutants 的输出目录（每次跑 `just mutants` 会重建，不进版本库）
/yi-agent-rs/mutants.out/
/yi-agent-rs/mutants.out.old/

# 探针运行产物（报告、运行元数据、stderr 副本）
/.artifacts/

# Node 依赖（contracts 的 schema 校验器按自己的 package-lock 安装）
node_modules/
