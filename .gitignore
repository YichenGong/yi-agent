# Rust build artifacts
/target/
**/target/

# Rust backup files
*.rs.bk
*.rs.orig

# Cargo.lock is committed for binary crates, ignored for library crates.
# Since this is a CLI (binary), we keep Cargo.lock tracked.

# IDE / editor
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Environment / secrets
.env
.env.*
!.env.example

# Logs / runtime
*.log

# yi-agent runtime state under each project workdir
# (unix socket, instance lock, runtime.sqlite and its -wal/-shm sidecars)
.yi-agent/

# Per-thread resume secrets the app-server writes under the workdir. Each file
# holds a live `resume-*` capability, so committing one would publish a working
# credential; they are runtime state, never source.
.session-identities/

# Git worktrees (isolated workspaces)
.worktrees/

# Claude Code hook state (记录上次检查到的 commit,用于增量检测代码变化)
.claude/.last-checked-commit
.claude/.last-merge-checked


# Added by cargo

/target

# Probe-only build tree (plugin-probe feature; never shipped)
/target-probe/
desktop/src-tauri/target-probe/

# npm package binaries (构建时填充,不入版本控制)
yi-agent-rs/yi-agent-cli/platforms/*/binaries/
yi-agent-rs/yi-agent-cli/platforms/*/yi-agent.app/
.worktrees/
dist/
# 例外：看板插件的发布清单为每个 view 记录了构建产物的 sha256。产物不入库，
# 清单就指向一个克隆里不存在的文件——那正是“看起来完整”的假象，装的时候才
# 报错。所以这条产物的字节必须和清单一起进版本库。
!/plugins/superpowers-kanban/ui/dist/

# cargo-mutants 的输出目录（每次跑 `just mutants` 会重建，不进版本库）
/yi-agent-rs/mutants.out/
/yi-agent-rs/mutants.out.old/

# 探针运行产物（报告、运行元数据、stderr 副本）
/.artifacts/

# Node 依赖（contracts 的 schema 校验器按自己的 package-lock 安装）
node_modules/

# Python 校验脚本的字节码缓存（`plugin-boundary-check` 会生成）
__pycache__/
